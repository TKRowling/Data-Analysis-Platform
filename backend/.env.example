APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Which language model to use: "ollama" or "cloudflare".
# Leave it as ollama unless you are testing.
# The platform works with neither reachable — questions fall back to keyword routing.
LLM_PROVIDER=ollama

# ── Ollama (the official service, runs on your machine) ──────────────
# With Docker Desktop use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=5m
OLLAMA_STREAM=false

# ── Cloudflare Workers AI (hosted, for testing) ──────────────────────
# Set LLM_PROVIDER=cloudflare to use these.
# Account ID: Cloudflare dashboard → Workers & Pages → Overview (right sidebar)
# API token:  My Profile → API Tokens → Create Token → Workers AI (Read)
# Keep the token out of git — put real values in .env, never in this file.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_TIMEOUT_SECONDS=60
CLOUDFLARE_TEMPERATURE=0.1
CLOUDFLARE_MAX_TOKENS=1024
